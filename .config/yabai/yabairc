#!/usr/bin/env sh

# yabai config
# See: https://github.com/koekeishiya/yabai/wiki/Configuration

# Tiling layout
yabai -m config layout                       bsp
yabai -m config window_placement             second_child

# Gaps — 10px all around windows
yabai -m config top_padding                  10
yabai -m config bottom_padding               10
yabai -m config left_padding                 10
yabai -m config right_padding                10
yabai -m config window_gap                   10

# Reserve space for the sketchybar bar (height 32 + y_offset 6 + margin 8)
# so windows tile below it instead of drawing over it. This is added on top
# of top_padding above.
yabai -m config external_bar                 all:46:0

# Focus behavior
yabai -m config mouse_follows_focus          off
yabai -m config focus_follows_mouse          off

yabai -m config window_shadow                float

# Keep the sketchybar spaces visualizer live: sketchybar only reads yabai's
# state once at startup and thereafter piggybacks on front-app-switched, so
# space/window changes that don't also change the frontmost app (e.g. moving
# a window between spaces) would otherwise never be reflected in the bar.
yabai -m signal --add event=space_changed action="sketchybar --trigger yabai_refresh"
yabai -m signal --add event=window_focused action="sketchybar --trigger yabai_refresh"
yabai -m signal --add event=window_created action="sketchybar --trigger yabai_refresh"
yabai -m signal --add event=window_destroyed action="sketchybar --trigger yabai_refresh"
yabai -m signal --add event=window_moved action="sketchybar --trigger yabai_refresh"

echo "yabai config loaded"
